# =======================================================
# Movie Explorer - Environment Configuration Template
# =======================================================

# Server Port
PORT=3000

# Application Environment (development, production)
APP_ENV=development

# TMDB (The Movie Database) - Primary Metadata & Watch Providers
# Obtain key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=675b1517e0b53ddcbfb61232248e60cd
TMDB_ACCESS_TOKEN=

# YouTube Data API v3 - Optional trailer query enrichment
# Obtain key at: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Vimeo API - Optional authorized streaming integration
VIMEO_ACCESS_TOKEN=
ENABLE_VIMEO=false

# Internet Archive Legal Stream Aggregation
ENABLE_INTERNET_ARCHIVE=true

# YouTube Embeddable Player Integration
ENABLE_YOUTUBE=true

# Allowed CORS Origins (e.g. http://localhost:4200 or *)
CORS_ORIGIN=*

# Internal Gateway / Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MovieVault2025!#Secure
ADMIN_TOKEN_SECRET=change-this-to-a-secure-random-secret
